#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# DECLARE DATA AND CONF FILES TO BACKUP
#=================================================
ynh_script_progression "Declaring files to be backed up..."

ynh_backup "$install_dir"
# The identity mapping DB (ynh_username <-> pubkey) - the whole point of
# backing this app up at all, since $install_dir is otherwise just the
# venv and unpacked source.
ynh_backup "$data_dir"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Backing up system configurations related to $app..."

ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_backup "/etc/systemd/system/$app.service"
ynh_backup "/etc/systemd/system/$app-mint-session.service"

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Backup of $app completed"
