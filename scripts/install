#!/bin/bash

source "$(dirname "$0")/_common.sh"
source /usr/share/yunohost/helpers

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

#=================================================
# INSTALL PYTHON VIRTUAL ENVIRONMENT
#=================================================
ynh_script_progression "Setting up the Python virtual environment..."

nostr_auth_install_venv

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# config_panel.toml's relays_default is bind="settings" - YunoHost's own
# config panel machinery requires every such question to already have a
# value from install/upgrade (app_config_get/set fail outright otherwise:
# "should be initialized with a value during install or upgrade"). Empty
# is a valid, intentional value here (see _widen_with_caller_relays and
# nostr_blog/armada's own resolution chains: an empty shared default is
# just "nothing to contribute," never an error).
ynh_app_setting_set --key=relays_default --value=""

if ! getent group nostr-auth-lookup >/dev/null; then
	groupadd --system nostr-auth-lookup
fi
if id yunohost_mcp >/dev/null 2>&1; then
	usermod --append --groups nostr-auth-lookup yunohost_mcp
fi

ynh_config_add_nginx

ynh_config_add_systemd --service="$app-mint-session" --template="nostr_auth-mint-session.service"
ynh_config_add_systemd --service="$app-identity-lookup" --template="nostr_auth-identity-lookup.service"
ynh_config_add_systemd --service="$app-relay-lookup" --template="nostr_auth-relay-lookup.service"
ynh_config_add_systemd

# PLAN.md Phase 13: "rate limiting, brute-force throttling." server.py
# logs each failed login/link/unlink attempt (with the real client IP -
# see its _client_ip) to the file below, via
# NOSTR_AUTH_SECURITY_LOG_PATH in conf/systemd.service's LogsDirectory=.
ynh_config_add_fail2ban \
	--logpath="/var/log/$app/$app.log" \
	--failregex="^.*(nostr login failure|identity link failure|identity unlink failure) from <HOST>:.*$"

yunohost service add "$app-mint-session" --description="Nostr authentication: privileged session-minting helper"
yunohost service add "$app-identity-lookup" --description="Nostr authentication: private linked-identity lookup"
yunohost service add "$app-relay-lookup" --description="Nostr authentication: private relay-list lookup"
yunohost service add "$app" --description="Nostr authentication add-on for YunoHost"

#=================================================
# START APP
#=================================================
ynh_script_progression "Starting $app's systemd services..."

# Started first and separately: $app.service's own startup doesn't
# actually depend on this being up yet (it only reaches it at request
# time, not at startup), but starting the privileged half first makes for
# a saner boot order regardless.
ynh_systemctl --service="$app-mint-session" --action="start" \
	--log_path="systemd" \
	--wait_until="listening on"

ynh_systemctl --service="$app-identity-lookup" --action="start" \
	--log_path="systemd" \
	--wait_until="identity lookup listening"

ynh_systemctl --service="$app-relay-lookup" --action="start" \
	--log_path="systemd" \
	--wait_until="relay lookup listening"

ynh_systemctl --service="$app" --action="start" \
	--log_path="systemd" \
	--wait_until="Uvicorn running on"

#=================================================
# PORTAL LOGIN BUTTON
#=================================================
ynh_script_progression "Adding a Nostr login link to the YunoHost portal..."

nostr_auth_install_portal_patch

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Installation of $app completed"
ynh_print_info "Visit https://$domain/nostr-login once you've linked a Nostr identity - see doc/ADMIN.md"
