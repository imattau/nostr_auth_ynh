#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

ynh_setup_source --dest_dir="$install_dir" --full_replace

#=================================================
# REINSTALL PYTHON VIRTUAL ENVIRONMENT
#=================================================
ynh_script_progression "Upgrading the Python virtual environment..."

nostr_auth_install_venv

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

if ! getent group nostr-auth-lookup >/dev/null; then
	groupadd --system nostr-auth-lookup
fi
if id yunohost_mcp >/dev/null 2>&1; then
	usermod --append --groups nostr-auth-lookup yunohost_mcp
fi

ynh_config_add_nginx

ynh_config_add_systemd --service="$app-mint-session" --template="nostr_auth-mint-session.service"
ynh_config_add_systemd --service="$app-identity-lookup" --template="nostr_auth-identity-lookup.service"
ynh_config_add_systemd

# PLAN.md Phase 13: "rate limiting, brute-force throttling" - see
# scripts/install for what this watches and why.
ynh_config_add_fail2ban \
	--logpath="/var/log/$app/$app.log" \
	--failregex="^.*(nostr login failure|identity link failure|identity unlink failure) from <HOST>:.*$"

yunohost service add "$app-mint-session" --description="Nostr authentication: privileged session-minting helper" 2>/dev/null || true
yunohost service add "$app-identity-lookup" --description="Nostr authentication: private linked-identity lookup" 2>/dev/null || true

#=================================================
# START APP
#=================================================
ynh_script_progression "Restarting $app's systemd services..."

ynh_systemctl --service="$app-mint-session" --action="restart" \
	--log_path="systemd" \
	--wait_until="listening on"

ynh_systemctl --service="$app-identity-lookup" --action="restart" \
	--log_path="systemd" \
	--wait_until="identity lookup listening"

ynh_systemctl --service="$app" --action="restart" \
	--log_path="systemd" \
	--wait_until="Uvicorn running on"

#=================================================
# PORTAL LOGIN BUTTON
#=================================================
ynh_script_progression "Refreshing the Nostr login link on the YunoHost portal..."

nostr_auth_install_portal_patch

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Upgrade of $app completed"
