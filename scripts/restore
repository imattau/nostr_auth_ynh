#!/bin/bash

# Unlike install/upgrade/remove, restore does not run with $PWD set to this
# script's own directory - it runs from the backup archive's extracted
# "backup" dir, a sibling of "settings" (where _common.sh actually lives,
# since "settings" is the backed-up copy of the app's own scripts/conf).
# Confirmed live: a bare `source _common.sh` here fails with "No such file
# or directory" during restore even though the identical line works fine
# in every other script.
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE THE APP MAIN DIR AND DATA DIR
#=================================================
ynh_script_progression "Restoring the app main directory..."

ynh_restore "$install_dir"
ynh_restore "$data_dir"

#=================================================
# RECREATE THE PYTHON VIRTUAL ENVIRONMENT
#=================================================
ynh_script_progression "Reinstalling the Python virtual environment..."

nostr_auth_install_venv

#=================================================
# RESTORE SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Restoring system configurations related to $app..."

ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"
# ynh_restore is a pure file-copy helper - unlike ynh_config_add_nginx, it
# never reloads anything. Confirmed live: without this, the restored
# location conf sits correctly on disk but nginx (already running from
# before this app was removed) keeps serving its own default page for
# every path under this domain until something reloads it.
ynh_systemctl --service=nginx --action=reload

# The identity-lookup and relay-lookup sockets' shared consumer-facing
# group - scripts/install creates this the same way, idempotently, since
# it may already exist if another app (e.g. yunohost-mcp) installed while
# this app was removed.
if ! getent group nostr-auth-lookup >/dev/null; then
	groupadd --system nostr-auth-lookup
fi

ynh_restore "/etc/systemd/system/$app-mint-session.service"
ynh_restore "/etc/systemd/system/$app-identity-lookup.service"
ynh_restore "/etc/systemd/system/$app-relay-lookup.service"
ynh_restore "/etc/systemd/system/$app.service"
# ynh_config_add_systemd (install/upgrade) always follows a unit file
# write with this - matching it here rather than relying on systemd
# noticing the restored files on its own.
systemctl daemon-reload

systemctl enable "$app-mint-session.service" --quiet
yunohost service add "$app-mint-session" --description="Nostr authentication: privileged session-minting helper"

systemctl enable "$app-identity-lookup.service" --quiet
yunohost service add "$app-identity-lookup" --description="Nostr authentication: private linked-identity lookup"

systemctl enable "$app-relay-lookup.service" --quiet
yunohost service add "$app-relay-lookup" --description="Nostr authentication: private relay-list lookup"

systemctl enable "$app.service" --quiet
yunohost service add "$app" --description="Nostr authentication add-on for YunoHost"

#=================================================
# START APP
#=================================================
ynh_script_progression "Starting $app's systemd services..."

ynh_systemctl --service="$app-mint-session" --action="start" \
	--log_path="systemd" \
	--wait_until="listening on"

ynh_systemctl --service="$app-identity-lookup" --action="start" \
	--log_path="systemd" \
	--wait_until="identity lookup listening"

ynh_systemctl --service="$app-relay-lookup" --action="start" \
	--log_path="systemd" \
	--wait_until="relay lookup listening"

ynh_systemctl --service="$app" --action="start" \
	--log_path="systemd" \
	--wait_until="Uvicorn running on"

#=================================================
# PORTAL LOGIN BUTTON
#=================================================
ynh_script_progression "Restoring the Nostr login link on the YunoHost portal..."

nostr_auth_install_portal_patch

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Restoration of $app completed"
