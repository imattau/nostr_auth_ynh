#!/bin/bash
#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source "$(dirname "$0")/_common.sh"
source /usr/share/yunohost/helpers

ynh_abort_if_errors

#=================================================
# RETRIEVE ARGUMENTS
#=================================================

install_dir=$(ynh_app_setting_get --key=install_dir)
data_dir=$(ynh_app_setting_get --key=data_dir)

# Unlike conf/systemd.service, nothing here sets NOSTR_AUTH_DATA_DIR - a
# config-panel action's environment isn't the running service's. Confirmed
# live: without this, admin_cli.py falls back to its default relative
# "./data" path and writes/reads a completely different (and, from this
# script's actual working directory, likely uncreated) SQLite file than
# the one nostr_auth.service uses - the action reports success, but the
# service never sees the change.
_nostr_auth_admin() {
	NOSTR_AUTH_DATA_DIR="$data_dir" "$install_dir/venv/bin/yunohost-nostr-auth-admin" "$@"
}

# Config-panel actions always run as root, unlike nostr_auth.service
# (its own unprivileged system user) - a write here leaves the SQLite
# file (and any -wal/-shm sidecar SQLite creates alongside it) owned by
# root, which the running service can no longer read/write under
# ProtectSystem=strict. Confirmed live: a link reported as successful
# here still showed up as unlinked to the real, running service until
# this got called afterwards. Same pattern as yunohost-mcp_ynh's
# _ymcp_fix_perms.
_nostr_auth_fix_perms() {
	chown "$app:$app" "$data_dir"/identities.db* 2> /dev/null || true
	chmod 640 "$data_dir"/identities.db* 2> /dev/null || true
}

#=================================================
# GETTERS
#=================================================

get__identities_summary() {
	local summary
	summary="$(_nostr_auth_admin list 2>&1)" \
		|| summary="(could not read identities: $summary)"
	cat <<EOF
ask:
  en: |
$(echo "$summary" | sed 's/^/    /')
EOF
}

#=================================================
# ACTIONS
#=================================================

# PLAN.md Phase 5/14: admin-provisioned linking - no live signature
# required, unlike /nostr-account's self-service flow. Reaching this
# config panel at all already means administering this YunoHost server;
# yunohost-nostr-auth-admin (run in the app's own venv) talks straight to
# the same SQLite mapping DB the running service reads.
run__do_link() {
	[ -n "${link_username:-}" ] || ynh_die "Choose a YunoHost account to link"
	[ -n "${link_npub:-}" ] || ynh_die "Enter the Nostr public key (npub or hex) to link"

	local output rc=0
	output="$(_nostr_auth_admin link "$link_username" "$link_npub" 2>&1)" || rc=$?
	[ "$rc" -eq 0 ] || ynh_die "Could not link identity: $output"
	_nostr_auth_fix_perms
	ynh_print_info "$output"
}

run__do_unlink() {
	[ -n "${unlink_username:-}" ] || ynh_die "Choose a YunoHost account to unlink"

	local output
	output="$(_nostr_auth_admin unlink "$unlink_username" 2>&1)" \
		|| ynh_die "Could not unlink identity: $output"
	_nostr_auth_fix_perms
	ynh_print_info "$output"
}

#=================================================
ynh_app_config_run "$1"
