[Unit]
Description=Nostr Authentication: sign in to YunoHost with a linked Nostr identity
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__

# Unlike yunohost-mcp, this service does not need to run as root: it only
# needs to look up existing YunoHost users and establish sessions for them
# (PLAN.md's ynh/permissions.py), not drive systemctl/apt/LDAP admin
# operations. That narrower requirement is exactly why PLAN.md's Phase 1
# investigation into YunoHost's session-creation internals matters - it
# determines what privilege this service actually needs.
WorkingDirectory=__INSTALL_DIR__/
Environment=PATH=__INSTALL_DIR__/venv/bin:/usr/bin:/bin
Environment=NOSTR_AUTH_DATA_DIR=__DATA_DIR__
Environment=NOSTR_AUTH_PORTAL_API_BASE_URL=http://127.0.0.1:6788
# The one thing this otherwise-unprivileged process needs a narrow escape
# hatch for: minting a real YunoHost session requires the ynh-portal
# system user's privileges (PHASE0_INVESTIGATION.md's Conclusions), which
# it reaches via `sudo -n -u ynh-portal` to exactly this one helper binary
# (see ../conf/sudoers). That's also why NoNewPrivileges=no is set
# explicitly below (not just omitted): several of this unit's own other
# hardening options - RestrictNamespaces=, SystemCallFilter=, and
# LockPersonality= among them - each *imply* NoNewPrivileges=yes on their
# own in systemd, regardless of whether it's written out. Confirmed on a
# real install: even with the explicit NoNewPrivileges=yes line removed,
# sudo still failed with "The 'no new privileges' flag is set" until this
# was added. The rest of this unit's sandboxing is about constraining what
# a compromised process could do *without* using that one sanctioned sudo
# path, not about preventing sudo from working at all.
Environment=NOSTR_AUTH_MINT_SESSION_HELPER=__INSTALL_DIR__/venv/bin/yunohost-nostr-auth-mint-session
Environment=NOSTR_AUTH_MINT_SESSION_USER=ynh-portal
ExecStart=__INSTALL_DIR__/venv/bin/yunohost-nostr-auth --host 127.0.0.1 --port __PORT__
Restart=always
RestartSec=5

# ProtectHome=yes is deliberately omitted: it makes /home inaccessible and
# empty regardless of ReadWritePaths, which fights the carve-out below for
# __DATA_DIR__ (which lives under /home/yunohost.app/__APP__) - confirmed
# on a real install, where this combination made the daemon crash-loop on
# PermissionError trying to create its own data directory. ProtectSystem=
# strict already makes everything else read-only except ReadWritePaths.
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @swap
ReadWritePaths=__DATA_DIR__

[Install]
WantedBy=multi-user.target
