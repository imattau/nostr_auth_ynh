[Unit]
Description=Nostr Authentication: sign in to YunoHost with a linked Nostr identity
After=network.target __APP__-mint-session.service
Wants=__APP__-mint-session.service

[Service]
Type=simple
User=__APP__
Group=__APP__

# Unlike yunohost-mcp, this service does not need to run as root: it only
# needs to look up existing YunoHost users and establish sessions for them
# (PLAN.md's ynh/permissions.py), not drive systemctl/apt/LDAP admin
# operations. That narrower requirement is exactly why PLAN.md's Phase 1
# investigation into YunoHost's session-creation internals matters - it
# determines what privilege this service actually needs.
WorkingDirectory=__INSTALL_DIR__/
Environment=PATH=__INSTALL_DIR__/venv/bin:/usr/bin:/bin
Environment=NOSTR_AUTH_DATA_DIR=__DATA_DIR__
Environment=NOSTR_AUTH_PORTAL_API_BASE_URL=http://127.0.0.1:6788
# Minting a real YunoHost session requires the ynh-portal system user's
# privileges (PHASE0_INVESTIGATION.md's Conclusions). This process never
# gains that privilege itself - it asks ../conf/nostr_auth-mint-session.service
# (a separate, always-running ynh-portal-owned process) over this Unix
# socket. A sudo-spawned-per-request helper was the original design here
# and does NOT work on a (containerized) install where the container sets
# the kernel's no_new_privs flag - confirmed live: "sudo: The 'no new
# privileges' flag is set, which prevents sudo from running as root," and
# no setting in *this* unit can override a restriction imposed at the
# container level. See PHASE0_INVESTIGATION.md's "Privilege-drop redesign"
# for the full story - this is why NoNewPrivileges is left at its systemd
# default (effectively enabled) below rather than carved out: this process
# has no legitimate reason to ever escalate privilege, unlike the old
# sudo-based design.
Environment=NOSTR_AUTH_MINT_SESSION_SOCKET=/run/nostr_auth-mint/__APP__.sock
# PLAN.md Phase 13: "rate limiting, brute-force throttling." LogsDirectory=
# creates/owns /var/log/__APP__ for us (and, unlike a plain path, is one of
# the directives systemd auto-carves an exception for under
# ProtectSystem=strict, same as ReadWritePaths below) - server.py writes
# failed-login/-link/-unlink lines there, and ynh_config_add_fail2ban
# (scripts/install) watches that file for them.
LogsDirectory=__APP__
Environment=NOSTR_AUTH_SECURITY_LOG_PATH=/var/log/__APP__/__APP__.log
ExecStart=__INSTALL_DIR__/venv/bin/yunohost-nostr-auth --host 127.0.0.1 --port __PORT__
Restart=always
RestartSec=5

# ProtectHome=yes is deliberately omitted: it makes /home inaccessible and
# empty regardless of ReadWritePaths, which fights the carve-out below for
# __DATA_DIR__ (which lives under /home/yunohost.app/__APP__) - confirmed
# on a real install, where this combination made the daemon crash-loop on
# PermissionError trying to create its own data directory. ProtectSystem=
# strict already makes everything else read-only except ReadWritePaths.
PrivateTmp=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @swap
ReadWritePaths=__DATA_DIR__

[Install]
WantedBy=multi-user.target
